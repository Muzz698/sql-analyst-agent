# Copy to .env and fill in. Never commit .env.

# --- LLM: groq | ollama | fake ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Exponential backoff for rate limits (Groq free tier)
LLM_MAX_ATTEMPTS=5
LLM_BACKOFF_INITIAL_S=2
LLM_BACKOFF_MAX_S=60

# --- Database ---
# DB_PATH=data/chinook.sqlite
QUERY_TIMEOUT_MS=5000
DEFAULT_ROW_LIMIT=200

# --- Agent behaviour ---
MAX_SQL_RETRIES=3
USE_FEW_SHOT=true
USE_SCHEMA_PRUNING=true
REQUIRE_APPROVAL_FOR_FLAGGED=true

# --- Evaluation ---
EVAL_DELAY_S=2

# --- LangSmith (free tier) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sql-analyst-agent
